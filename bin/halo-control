#!/bin/bash
# halo-control [--fake] | connect HOST | disconnect | stop | status | log | install-login | uninstall-login
#   (no argument)    start the dashboard server if it is not running, then open http://127.0.0.1:8711/
#   --fake           the same with the fake backend (no SSH, no GPUs): for trying the dashboard
#   connect HOST     use a StrixFold server that is already running on HOST (ssh's name for it, or user@address): nothing
#                    else is needed on the boxes. disconnect forgets it
#   stop / status    stop it / say whether it runs
#   log              follow ~/Library/Logs/halo-control.log
#   install-login    start it at login (writes ~/Library/LaunchAgents/com.halo-control.dashboard.plist and loads it)
#   uninstall-login  undo install-login
set -euo pipefail
SELF=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")
REPO=$(cd "$(dirname "$SELF")/.." && pwd)
PORT=$(python3 -c 'import json,os; p=os.path.expanduser("~/.config/halo-control/config.json"); print(json.load(open(p)).get("ui_port", 8711) if os.path.exists(p) else 8711)')
URL="http://127.0.0.1:$PORT/"
PIDF="$HOME/Library/Caches/halo-control/server.pid"
LOG="$HOME/Library/Logs/halo-control.log"
PLIST="$HOME/Library/LaunchAgents/com.halo-control.dashboard.plist"
mkdir -p "$(dirname "$PIDF")" "$(dirname "$LOG")"
running() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
up() { curl -s -m 2 -o /dev/null -w '%{http_code}' -H "Host: 127.0.0.1:$PORT" "$URL" 2>/dev/null | grep -q 200; }
case "${1:-}" in
  connect|disconnect)
    /usr/bin/python3 -X pycache_prefix=/var/empty/halo-nopyc "$REPO/mac/connect.py" "$@" || exit $?
    if running && ps -o command= -p "$(cat "$PIDF")" | grep -q "mac/halo_control.py"; then
      kill "$(cat "$PIDF")" 2>/dev/null || true; for _ in $(seq 1 100); do running || break; sleep 0.2; done
      running && { echo "halo-control: it is still stopping; run halo-control in a moment"; exit 1; }
    fi
    [ "$1" = connect ] && exec "$SELF"
    exit 0;;
  ""|--fake)
    if ! running && up; then  # something else answers on the port: never send it the page, its key or the cookie
      echo "halo-control: another program is answering on 127.0.0.1:$PORT; stop it first"; exit 1
    fi
    if running && up; then
      if [ "${1:-}" = --fake ] && ! curl -s -m 2 "${URL}local/status" | grep -q '"fake": true'; then
        echo "halo-control: the real dashboard is running; 'halo-control stop' first to try the fake backend"; exit 1
      fi
    else
      nohup /usr/bin/python3 -X pycache_prefix=/var/empty/halo-nopyc "$REPO/mac/halo_control.py" serve ${1:-} >>"$LOG" 2>&1 </dev/null &
      echo $! > "$PIDF"
      for _ in $(seq 1 50); do up && break; sleep 0.1; done
      # ours, not a program that took the port while it started: its page and cookie go to its own server only
      running && up || { echo "halo-control: the server did not start (is another program on 127.0.0.1:$PORT?); see $LOG"; tail -5 "$LOG"; exit 1; }
    fi
    echo "halo-control: $URL"
    # with this run's key, so the first screen's Skip works here (the page is 0600 in this account's own Library)
    if [ "${1:-}" = --fake ]; then OPENP="$HOME/Library/Caches/halo-control/fake/open-$PORT.html"
    else OPENP="$(/usr/bin/getconf DARWIN_USER_CACHE_DIR 2>/dev/null || echo "$HOME/Library/Caches/")halo-control/open-$PORT.html"; fi
    if [ -r "$OPENP" ]; then open "$OPENP"; else open "$URL"; fi;;
  stop)
    if running; then  # it waits until the port is free again, so that a start right after works
      P=$(cat "$PIDF"); kill "$P"; for _ in $(seq 1 100); do kill -0 "$P" 2>/dev/null || break; sleep 0.1; done
      rm -f "$PIDF" && echo "halo-control: stopped"; else echo "halo-control: not running"; fi
    [ -f "$PLIST" ] && echo "(it starts again at login: halo-control uninstall-login to stop that)"; true;;
  status) if running && up; then echo "halo-control: running ($(cat "$PIDF")) at $URL"; else echo "halo-control: not running"; fi;;
  log) tail -f "$LOG";;
  install-login)
    mkdir -p "$(dirname "$PLIST")"
    sed -e "s|__PY__|/usr/bin/python3|; s|__SERVER__|$REPO/mac/halo_control.py|; s|__LOG__|$LOG|g; s|__PATH__|$PATH|" "$REPO/mac/launchd/com.halo-control.dashboard.plist" > "$PLIST"
    # the running server stops first (its port free again), then launchd starts it; the server writes $PIDF itself
    if running; then kill "$(cat "$PIDF")" 2>/dev/null || true; for _ in $(seq 1 100); do running || break; sleep 0.2; done; fi
    rm -f "$PIDF"
    launchctl bootstrap "gui/$(id -u)" "$PLIST" || exit 1
    for _ in $(seq 1 100); do up && break; sleep 0.2; done
    up && echo "halo-control: starts at login now ($PLIST); running ($(cat "$PIDF" 2>/dev/null))" \
       || { echo "halo-control: installed, but the server did not answer; see $LOG"; exit 1; };;
  uninstall-login)
    # launchd stops the server it started, so this leaves the dashboard stopped
    launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true; rm -f "$PLIST"
    echo "halo-control: no longer starts at login (run halo-control to start it now)";;
  *) sed -n '2,12p' "$SELF" | sed 's/^# \{0,1\}//'; exit 2;;
esac
